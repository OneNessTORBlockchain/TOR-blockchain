# Local node config carries the live admin token — commit config.example.yaml instead
config.yaml
config.local.yaml

# .env IS tracked on purpose: this repository is private and the operator wants the
# Pinata/IPFS credentials active on every checkout and deploy (core.config.load_dotenv
# reads it; real environment variables still win). Rotate the keys before the repo is
# ever made public, transferred or forked.

